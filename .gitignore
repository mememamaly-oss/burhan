__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
.next/

# R16-1: results/ is the CLI's runtime --out dir (scan / benchmark /
# replay state) — per-run output, never tracked. The tree-hygiene gate
# (scripts/audit_tree_hygiene.py, ci job "tree-hygiene") is the CI
# backstop; this ignore line keeps `git add -A` honest for NEW files.
results/

# Same class, specific artifact: `burhan capability-matrix` writes this
# machine-generated matrix at the repo root (the CLI battery exercises
# it) — it reached main via add -A in r15 (3e34202). Gate blocks
# tracking it anywhere; this keeps add -A from sweeping it untracked.
CAPABILITY_MATRIX.md

# Phase-A.3b (2026-11-10): credential artifacts must never be swept in by
# add -A. The tree-hygiene gate DENY_RULES make tracking them fail CI; these
# lines keep `git add -A` honest in the first place. .env.example stays
# tracked (CREDENTIAL_ALLOWLIST in the gate, placeholders only).
.secrets/
.env
.env.*
!.env.example
*.pat
*.pem
*.key
id_rsa*
